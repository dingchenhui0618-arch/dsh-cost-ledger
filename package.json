{
  "name": "dsh-cost-ledger",
  "version": "0.1.0",
  "description": "Auditable token-cost ledger for DeepSeek Harness: per-call model/token/CNY records, hour/day/session aggregates, JSON|CSV export, dry-run preview, and a side-by-side diff against manually entered platform bills.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-cost-ledger": "./bin/cost-ledger.mjs"
  },
  "files": [
    "lib",
    "bin",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cost",
    "token",
    "billing",
    "ledger",
    "reconciliation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingchenhui0618-arch/dsh-cost-ledger.git"
  },
  "homepage": "https://github.com/dingchenhui0618-arch/dsh-cost-ledger#readme",
  "bugs": {
    "url": "https://github.com/dingchenhui0618-arch/dsh-cost-ledger/issues"
  },
  "license": "MIT"
}
